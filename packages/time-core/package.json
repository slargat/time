{
  "name": "@tanstack/time-core",
  "version": "0.0.0",
  "description": "Headless calendar kernel (feature-composed, framework-agnostic) in the style of TanStack Table v9 table-core",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/time.git",
    "directory": "packages/time-core"
  },
  "homepage": "https://tanstack.com/time",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "time",
    "calendar"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./reactivity": {
      "require": "./dist/reactivity.cjs",
      "import": "./dist/reactivity.js"
    },
    "./static-functions": {
      "require": "./dist/static-functions.cjs",
      "import": "./dist/static-functions.js"
    },
    "./store-reactivity-bindings": {
      "require": "./dist/store-reactivity-bindings.cjs",
      "import": "./dist/store-reactivity-bindings.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "src"
  ],
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tanstack/store": "^0.11.0"
  },
  "devDependencies": {
    "vite-tsconfig-paths": "^6.1.1"
  }
}
